# Required: used by client/agent.py to call Gemini for tool selection + synthesis.
GEMINI_API_KEY=

# Append-only JSON Lines audit trail shared by the orchestrator and A2A
# specialists. Use an absolute path when they run from different directories.
AUDIT_LOG_PATH=audit.jsonl

# --- Persistent memory system ---
# Chat: Redis stores the expiring context window; this vault is the durable,
# human-reviewable Markdown knowledge layer.
MEMORY_REDIS_URL=redis://127.0.0.1:6379/0
CHAT_MEMORY_REDIS_TTL_SECONDS=3600
OBSIDIAN_VAULT_PATH=./memory-data/obsidian-vault

# Agent: Redis is working memory; Cognee is semantic/episodic graph memory.
# Set false only for local development where semantic recall is deliberately off.
AGENT_MEMORY_COGNEE_ENABLED=true
AGENT_EXECUTION_DB_PATH=./memory-data/executions.sqlite3
AGENT_ARTIFACT_ROOT=./memory-data/artifacts

# Optional: NVD API key for cve_lookup.py. Without it, lookups are self-throttled
# to NVD's unauthenticated limit of 5 requests / 30s. With it, the limit is
# 50 requests / 30s. Get one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional: server bind address/port (defaults shown).
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Required: bearer token clients must send to the MCP server. The server
# refuses to start without this set -- generate one with:
# python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Optional: which MCP server the client connects to (single-server mode,
# the default). Only needed if not running on localhost:8000.
MCP_SERVER_URL=http://127.0.0.1:8000/mcp/

# --- Multi-server (optional) ---
# Set MCP_SERVER_URLS to connect the client to MORE THAN ONE MCP server at
# once -- their tools are merged (auto-namespaced as "srv1__toolname",
# "srv2__toolname", ...) for Gemini to choose from. When set, this replaces
# MCP_SERVER_URL entirely (single-server settings above are ignored).
# MCP_SERVER_URLS=http://127.0.0.1:8000/mcp/,http://127.0.0.1:8010/mcp/
#
# One token per server, matched by position to MCP_SERVER_URLS. If a
# position is blank or the list is shorter, MCP_AUTH_TOKEN is used as the
# fallback for that server.
# MCP_AUTH_TOKENS=token-for-server-1,token-for-server-2

# NOTE: breach_check.py uses HIBP's Pwned Passwords range API, which requires
# NO API key. Do not add an HIBP_API_KEY here -- none is needed or used.

# --- A2A pipeline (optional) ---
# Ports/URLs for the two A2A specialist servers (agents/security_specialist.py,
# agents/report_writer_specialist.py) and where the orchestrator
# (agents/orchestrator.py) looks for them. Defaults shown -- only needed if
# not running on localhost with these ports.
SECURITY_SPECIALIST_HOST=127.0.0.1
SECURITY_SPECIALIST_PORT=8100
SECURITY_SPECIALIST_URL=http://127.0.0.1:8100

REPORT_WRITER_HOST=127.0.0.1
REPORT_WRITER_PORT=8200
REPORT_WRITER_URL=http://127.0.0.1:8200

# Optional: connect the orchestrator to a different/larger set of A2A
# specialists (comma-separated URLs). When set, this replaces
# SECURITY_SPECIALIST_URL/REPORT_WRITER_URL entirely.
# A2A_SPECIALIST_URLS=http://127.0.0.1:8100,http://127.0.0.1:8200

# NOTE: the A2A specialist servers have NO auth of their own in this version
# (unlike the MCP server's MCP_AUTH_TOKEN) -- a documented gap, not an
# oversight. See README "Multi-agent (A2A) pipeline" for details.
